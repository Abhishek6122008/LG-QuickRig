# Normalize all text files to LF in the repo;
# Git will convert to CRLF on checkout on Windows.
* text=auto eol=lf

# Dart / Flutter source
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Kotlin / Java / XML
*.kt   text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.kts  text eol=lf

# C / C++ (Linux runner)
*.cc   text eol=lf
*.h    text eol=lf
*.cmake text eol=lf

# Shell scripts always LF
*.sh   text eol=lf

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
