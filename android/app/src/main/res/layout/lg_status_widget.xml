<?xml version="1.0" encoding="utf-8"?>
<!--
    LG QuickRig — Live Status widget (2x2)

    RemoteViews constraints (runs inside the launcher process):
      - No custom views; only standard framework View subclasses.
      - Status indicator uses setImageViewResource() to swap between three
        circle drawables: status_circle_online / status_circle_offline / status_circle_pending.
      - Colors are hardcoded — theme attributes are not resolved in RemoteViews.
      - All dynamic text is set via setTextViewText() in LGStatusWidgetProvider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E6101418"
    android:padding="12dp"
    android:gravity="center">

    <!-- App label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LG QuickRig"
        android:textSize="10sp"
        android:textColor="#80FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <!-- Status dot — swapped between three drawables by LGStatusWidgetProvider -->
    <ImageView
        android:id="@+id/status_indicator"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/status_circle_pending"
        android:layout_marginBottom="8dp"
        android:contentDescription="Connection status" />

    <!-- "Connected" / "Disconnected" / "Checking" -->
    <TextView
        android:id="@+id/status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking"
        android:textSize="13sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="3dp" />

    <!-- Host IP or "Not configured" -->
    <TextView
        android:id="@+id/status_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="9sp"
        android:textColor="#80FFFFFF" />

    <!-- Last updated timestamp -->
    <TextView
        android:id="@+id/status_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="8sp"
        android:textColor="#60FFFFFF"
        android:layout_marginTop="4dp" />

</LinearLayout>
