<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWidgetProviderInfo — LG QuickRig Command Bar (4×1)

    Cell size formula (Google guideline): cells = (dp + 2) / 74
    300dp wide  → ~4 cells    48dp tall → ~1 cell

    updatePeriodMillis = 0 because the widget is stateless — it fires commands
    on tap and does not need a scheduled background refresh.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="300dp"
    android:minHeight="48dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/lg_home_widget"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
