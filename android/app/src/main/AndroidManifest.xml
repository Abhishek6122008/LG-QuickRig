<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SSH over TCP requires INTERNET permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="LG QuickRig"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- ── Main Flutter activity ─────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Dialog-only launcher for widget camera buttons ────────────── -->
        <!--
            Separate task + translucent window: the Fly To / Orbit / Overlay /
            Pin dialogs float over the launcher without opening the full app.
        -->
        <activity
            android:name=".CameraDialogActivity"
            android:exported="false"
            android:taskAffinity="com.liqtech.lg_quickrig.dialog"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/TransparentTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── Command Bar home screen widget (4×1) ──────────────────────── -->
        <!--
            android:exported="true" is required on API 31+ for receivers that
            handle implicit broadcasts (APPWIDGET_UPDATE comes from the system).
        -->
        <receiver
            android:name=".lg.LGHomeWidgetProvider"
            android:exported="true"
            android:label="LG QuickRig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Custom button actions routed back to this receiver -->
                <action android:name="com.liqtech.lg_quickrig.ACTION_CLEAN" />
                <action android:name="com.liqtech.lg_quickrig.ACTION_RELAUNCH" />
                <action android:name="com.liqtech.lg_quickrig.ACTION_REBOOT" />
                <action android:name="com.liqtech.lg_quickrig.ACTION_SHUTDOWN" />
                <action android:name="com.liqtech.lg_quickrig.ACTION_SYNC" />
                <action android:name="com.liqtech.lg_quickrig.ACTION_BLANK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lg_home_widget_info" />
        </receiver>

        <!-- ── Live Status widget (2x2) ─────────────────────────────────── -->
        <receiver
            android:name=".lg.LGStatusWidgetProvider"
            android:exported="true"
            android:label="LG Status">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.liqtech.lg_quickrig.ACTION_STATUS_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lg_status_widget_info" />
        </receiver>

        <!-- ── Quick Settings tile (API 24+ / Android 7+) ────────────────── -->
        <!--
            BIND_QUICK_SETTINGS_TILE restricts binding to the System UI process —
            no third-party app can impersonate the tile.
        -->
        <service
            android:name=".lg.LGQuickSettingsTile"
            android:exported="true"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Impeller + OpenGLES crashes on many emulators; use Skia instead. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>
